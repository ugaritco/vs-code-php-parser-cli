{
    "name": "ugarit-zero/ugarit-zero",
    "description": "The Ugarit Zero Framework.",
    "keywords": [
        "framework",
        "ugarit",
        "ugarit zero",
        "console",
        "cli"
    ],
    "homepage": "https://ugarit-zero.com",
    "type": "project",
    "license": "MIT",
    "version": "1.00.00",
    "support": {
        "issues": "https://github.com/ugarit-zero/ugarit-zero/issues",
        "source": "https://github.com/ugarit-zero/ugarit-zero"
    },
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Nuno Maduro",
            "email": "enunomaduro@gmail.com"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "require": {
        "php": "^8.2.0",
        "heritage/log": "^1.00.00",
        "ugarit-zero/framework": "^11.0.0",
        "microsoft/tolerant-php-parser": "^0.1.2",
        "stillat/blade-parser": "^1.10"
    },
    "require-dev": {
        "ugarit/pint": "^1.00.00",
        "mockery/mockery": "^1.6.11",
        "pestphp/pest": "^2.34.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "php-parser"
    ],
    "scripts": {
        "pre-autoload-dump": [
            "test -f fix-class-resolutions.php && php fix-class-resolutions.php || true"
        ]
    }
}
